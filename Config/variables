
#Config file names for .bashrc
declare -r config_files=(
    aliases 
    prompt 
    binds 
    functions 
    history-config
    )
#pwd_title='echo -ne "\033]0;$PWD\007"'
declare -r music_dir="/media/storage/Music"

declare -r HISTIGNORE_CMDS=(
    "ls*"
    ll
    __custom_clear
    pwd
    history
    bg
    fg
    exit
    clear
    reset
    "term-title*"
    "fileperm*"
    "git commit -*"
    "git add *"
    "git clone *"
)