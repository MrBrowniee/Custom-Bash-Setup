# Suppress shellcheck error for unused variables
  # shellcheck disable=SC2034

# Config file names for .bashrc
declare -ra config_files=(
  "$HOME/.shell/Zsh/Config/aliases" 
  "$HOME/.shell/Zsh/Config/prompt" 
  "$HOME/.shell/Zsh/Config/functions"
  "$HOME/.shell/Zsh/Config/history-config"
)
music_dir="/media/storage/Music"

# Ignored these commands in history
declare -ra HISTIGNORE_CMDS=(
  "ls*"
  ll
  "sudo*"
  __custom_clear
  pwd
  "history*"
  bg
  fg
  exit
  clear
  reset
  "term-title*"
  "fileperm*"
  "git commit -*"
  "git add *"
  "git clone *"
)